   "source": [
    "df = spark.read.parquet('partition/')\n",
    "df.createOrReplaceTempView('trips_data')\n",
    "\n",
    "df_3 = spark.sql(\"\"\"\n",
    "SELECT\n",
    "    count(1) AS trip_count\n",
    "FROM\n",
    "    trips_data\n",
    "WHERE\n",
    "    date(tpep_pickup_datetime) == '2025-11-15'\n",
    "\"\"\")\n",
    "                 \n",
    "df_3.show()"

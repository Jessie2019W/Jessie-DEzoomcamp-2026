   "source": [
    "df_4 = spark.sql(\"\"\"\n",
    "SELECT \n",
    "    round((unix_timestamp(tpep_dropoff_datetime) - unix_timestamp(tpep_pickup_datetime))/3600,1) AS length\n",
    "FROM\n",
    "    trips_data\n",
    "WHERE \n",
    "    tpep_dropoff_datetime > tpep_pickup_datetime\n",
    "ORDER BY\n",
    "    1 desc   \n",
    "LIMIT 5\n",
    "\"\"\")\n",
    "\n",
    "df_4.show(truncate=False)"
   ]
